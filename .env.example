# RAG 中台（rag-center）环境变量模板
# 用法：复制为 .env，然后只改 3 行：MODEL_BASE_URL、MODEL_API_KEY、DEEPSEEK_API_KEY。
# .env 里有明文 Key，已在 .gitignore 里；本文件是可提交的占位版。

# ── 基础 ──
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/rag_db
VECTOR_STORE=pgvector
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# ── 占位 Key 与 MCP 入口（第 1 步）──
# 数据面 HTTP 与 MCP 两扇门共用这个固定 token；第 5 步换成 api_keys 表真校验。
# ENABLE_MCP=false 只给离线测试/CI 用，生产保持 true。
DEV_API_KEY=dev-key
DEV_TENANT_ID=tenant_demo
ENABLE_MCP=true

# ── 结构化日志（第 2 步）──
# LOG_LEVEL 可用 DEBUG / INFO / WARNING / ERROR；LOG_DIR 不存在时自动创建。
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Embedding（必改：Base URL 从百炼控制台 API-KEY 页面复制，含业务空间 ID）──
MODEL_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=你的百炼key
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536
# 单批上限按模型：text-embedding-v3/v4=10、v1/v2=25、qwen3.7=20；默认 10 最保守。
EMBEDDING_BATCH_SIZE=10
# 嵌入实现：langchain（框架抽象，默认）/ openai_compatible（原有直连实现，回退）。
# 回退分支保留着——框架这一层出问题时，改这一个值就能把服务救回来。
EMBEDDING_PROVIDER=langchain

# ── 大模型（第 4 步票 1：换供应商只改这一段，业务代码零改动）──
# 供应商可选 deepseek / qwen / ark / openai / anthropic / gemini。
# 对应 key 留空 = 这台机器没有大模型能力：工厂返回空实现，服务照常启动，
# 相关能力明确不可用（抛 LLM_FAILED），而不是静默降级。
LLM_PROVIDER=deepseek
# 留空 = 用该供应商的内置默认地址（DeepSeek / 豆包 Ark 都有）。千问与 OpenAI 必须自己填：
# 它们的地址里嵌着工作空间 ID / 区域端点，没有通用默认值。
# ⚠️ 不要在这里写死某一家的地址：换 LLM_PROVIDER 时忘了清空，key 就会被发到上一家的域名上。
LLM_BASE_URL=
# 两档：fast 给查询改写与重排（延迟敏感，思考模式在代码里写死关闭），strong 留给 Research。
# deepseek-chat 已下线，现在的快模型是 deepseek-flash。
LLM_MODEL=deepseek-flash
LLM_STRONG_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
# 思考档位：off / low / medium / high。只对 strong 档生效，fast 档恒为关。
LLM_REASONING_EFFORT=off

# 各供应商的 key：留空即「这台机器没配这家」。
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 框架遥测（第 4 步票 1：默认不外发，并且要能被审计）──
# LangChain 的追踪客户端读这两个环境变量；Provider 构造模型前会把配置里的值同步过去。
# 没有 key 时它本来也发不出去，但企业环境要的是「显式关闭」这一行证据。
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=

# ── 重排（阶段 8 才用）──
RERANK_ENABLED=false
RERANK_BASE_URL=https://<空间ID>.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TOP_N=5
RERANK_MAX_CANDIDATES=20
RERANK_CHUNK_MAX_CHARS=1024
RERANK_TIMEOUT_SECONDS=15

# ── Elasticsearch（阶段 4 才用）──
KEYWORD_SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_chunks
RETRIEVAL_MODE=hybrid
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_TOP_N=20

# ── 鉴权（阶段 5 才用）──
AUTH_ENABLED=false

# ── 查询优化 ──
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_MS=2000

# ── 异步（阶段 3 才用）──
# broker 与 result backend 分库，任务队列和结果键互不干扰。
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── 观测（阶段 7 才用）──
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── 文档入库与边界 ──
# 原始文件落盘目录；单文件上限（MB）；表格切片每片最多行数。
DOCUMENT_STORAGE_PATH=./data/uploads
DOCUMENT_MAX_SIZE_MB=20
TABLE_MAX_ROWS_PER_CHUNK=10
QUERY_MAX_LENGTH=2000

# ── OCR（阶段 3 才用）──
# off 关闭 / auto 按需 / force 强制；OCR_OFFLINE=true 时只用本地模型、不出网。
OCR_MODE=auto
OCR_OFFLINE=false
# 离线模型目录与运行时动态库路径；留空则用打包默认值。
OCR_MODEL_DIRECTORY=
PDFIUM_LIB_PATH=
ORT_DYLIB_PATH=
