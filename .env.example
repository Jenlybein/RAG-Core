# RAG 中台（rag-center）环境变量模板
# 用法：复制为 .env，然后只改下面标了「必改」的 4 行。
# .env 里有明文 Key，已在 .gitignore 里；本文件是可提交的占位版。

# ── 基础 ──
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/rag_db
VECTOR_STORE=pgvector
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# ── Embedding（必改：Base URL 从百炼控制台 API-KEY 页面复制，含业务空间 ID）──
MODEL_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=你的百炼key
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536

# ── 大模型（必改：LLM_API_KEY；账号里没有 deepseek-v4-pro 就改成 deepseek-chat）──
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=你的deepseek key
LLM_MODEL=deepseek-chat
LLM_STRONG_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60

# ── 重排（阶段 8 才用）──
RERANK_ENABLED=false
RERANK_BASE_URL=https://<空间ID>.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TOP_N=5
RERANK_MAX_CANDIDATES=20
RERANK_CHUNK_MAX_CHARS=1024
RERANK_TIMEOUT_SECONDS=15

# ── Elasticsearch（阶段 4 才用）──
KEYWORD_SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_chunks
RETRIEVAL_MODE=hybrid
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_TOP_N=20

# ── 鉴权（阶段 5 才用）──
AUTH_ENABLED=false

# ── 查询优化 ──
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_MS=2000

# ── 异步（阶段 3 才用）──
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── 观测（阶段 7 才用）──
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── 文档与边界 ──
DOCUMENT_STORAGE_PATH=./data/uploads
DOCUMENT_MAX_SIZE_MB=20
TABLE_MAX_ROWS_PER_CHUNK=10
QUERY_MAX_LENGTH=2000
