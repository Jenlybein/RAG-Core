# RAG 中台（rag-center）环境变量模板
# 用法：复制为 .env，然后只改 3 行：MODEL_BASE_URL、MODEL_API_KEY、DEEPSEEK_API_KEY。
# .env 里有明文 Key，已在 .gitignore 里；本文件是可提交的占位版。

# ── 基础 ──
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/rag_db
VECTOR_STORE=pgvector
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# ── 占位 Key 与 MCP 入口（第 1 步）──
# 数据面 HTTP 与 MCP 两扇门共用这个固定 token；第 5 步换成 api_keys 表真校验。
# ENABLE_MCP=false 只给离线测试/CI 用，生产保持 true。
DEV_API_KEY=dev-key
DEV_TENANT_ID=tenant_demo
ENABLE_MCP=true

# ── 结构化日志（第 2 步）──
# LOG_LEVEL 可用 DEBUG / INFO / WARNING / ERROR；LOG_DIR 不存在时自动创建。
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Embedding（必改：Base URL 从百炼控制台 API-KEY 页面复制，含业务空间 ID）──
MODEL_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=你的百炼key
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536
# 单批上限按模型：text-embedding-v3/v4=10、v1/v2=25、qwen3.7=20；默认 10 最保守。
EMBEDDING_BATCH_SIZE=10
# 嵌入实现：langchain（框架抽象，默认）/ openai_compatible（原有直连实现，回退）。
# 回退分支保留着——框架这一层出问题时，改这一个值就能把服务救回来。
EMBEDDING_PROVIDER=langchain

# ── 大模型（第 4 步票 1：换供应商只改这一段，业务代码零改动）──
# 供应商可选 deepseek / qwen / ark / openai / anthropic / gemini。
# 对应 key 留空 = 这台机器没有大模型能力：工厂返回空实现，服务照常启动，
# 相关能力明确不可用（抛 LLM_FAILED），而不是静默降级。
LLM_PROVIDER=deepseek
# 留空 = 用该供应商的内置默认地址（DeepSeek / 豆包 Ark 都有）。千问与 OpenAI 必须自己填：
# 它们的地址里嵌着工作空间 ID / 区域端点，没有通用默认值。
# ⚠️ 不要在这里写死某一家的地址：换 LLM_PROVIDER 时忘了清空，key 就会被发到上一家的域名上。
LLM_BASE_URL=
# 两档：fast 给查询改写与重排（延迟敏感，思考模式在代码里写死关闭），strong 留给 Research。
# deepseek-chat 已下线，现在的快模型是 deepseek-flash。
LLM_MODEL=deepseek-flash
LLM_STRONG_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60
# 思考档位：off / low / medium / high。只对 strong 档生效，fast 档恒为关。
LLM_REASONING_EFFORT=off

# 各供应商的 key：留空即「这台机器没配这家」。
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ARK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── 框架遥测（第 4 步票 1：默认不外发，并且要能被审计）──
# LangChain 的追踪客户端读这两个环境变量；Provider 构造模型前会把配置里的值同步过去。
# 没有 key 时它本来也发不出去，但企业环境要的是「显式关闭」这一行证据。
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=

# ── 重排（第 4 步票 7 起：融合之后，默认关闭）──
# 重排：一期是「包着大模型能力」的实现（ADR-0011），所以没有独立的端点 / key / 模型名——
# 它用的是 LLM_PROVIDER 那一套。阶段 8 换专业重排模型时才需要下面这几个键。
RERANK_ENABLED=false
# 送进模型的候选数与单条截断；候选池不够宽时重排只能原地微调，所以它通常 > TOP_K。
RERANK_MAX_CANDIDATES=20
RERANK_CHUNK_MAX_CHARS=1024
RERANK_TIMEOUT_SECONDS=15

# ── Elasticsearch（第 4 步票 3 起：关键词通道）──
# none = 明确没有关键词能力（离线测试 / CI 的默认值）；elasticsearch = 走 ES。
# 拼错的名字会让工厂直接报错，不会悄悄退回空实现。
KEYWORD_SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_chunks
# 三种取值都真可用：vector / bm25 / hybrid。票 4 起默认 hybrid（缺省值来自服务端配置，
# 请求体不传 mode 时用它；MCP 入口也只传 query，行为随这里变化）。
# 混合模式下关键词引擎不可用只会降级，不会让默认配置在离线机器上直接报错。
RETRIEVAL_MODE=hybrid
# 下面几项是后续票要用的预留键，当前代码**不读**：融合算法固定 RRF、k 固定 60
# （写死在 app/services/retrieval/fusion.py），各通道召回数与 top_k 同值。
# 融合算法与 k 值写死在代码里（HYBRID_FUSION / HYBRID_RRF_K 不再是配置项）：
# 它们一旦可调，同一套数据在不同部署上的排序就不可比。
# 每路召回深度：召回宽、返回窄——两路各找这么多条再融合，最终仍只返回 top_k 条。
HYBRID_RECALL_TOP_K=20

# ── 鉴权（第 7 步引入）──
# false = 落进内置开发身份（仍需带 DEV_API_KEY 那把占位 token）；true = 只认 api_keys 表里的真 Key。
# **生产必须 true**：打开后内置开发身份不可达。
AUTH_ENABLED=false
# 限流与日配额开关（第 7 步票 #79）：false = 两道关卡整段 no-op（所有租户无限额度）。
# **生产必须 true**：打开后秒级 QPS 与按天配额才真的计数，状态在 Redis 里跨进程共享。
# 刻意做成显式开关而不是「连不上 Redis 时自动放行」：Redis 一挂就静默解除全部限流，
# 平台看起来完全健康，直到账单或 Worker 队列把真相捅出来。
RATE_LIMIT_ENABLED=false
# 套餐缓存的 Redis 库（与 Celery 的 0/1 号库分开）；改完套餐删缓存、不写缓存，TTL 只是兜底。
REDIS_URL=redis://localhost:6379/2
PLAN_CACHE_TTL_SECONDS=60

# ── 查询优化（第 4 步票 6：召回之前的两步，都默认关闭）──
# 改写：口语 → 文档表述，只影响向量一路（与重排）。它走 LLM_PROVIDER 的 fast 模型角色，
# 没有独立端点 / 模型名；超时按失败处理 → 回退原句并标 degraded，检索照常返回。
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_MS=2000
# 同义词扩展：纯函数 + 词表来自各知识库的 settings["synonyms"]（库级配置，不跨库不跨租户），
# 只影响关键词一路。改词表下一次请求立即生效，不需要重建索引。
SYNONYM_EXPANSION_ENABLED=false

# ── 异步（阶段 3 才用）──
# broker 与 result backend 分库，任务队列和结果键互不干扰。
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── 观测（阶段 7 才用）──
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── 文档入库与边界 ──
# 原始文件落盘目录；单文件上限（MB）；表格切片每片最多行数。
DOCUMENT_STORAGE_PATH=./data/uploads
DOCUMENT_MAX_SIZE_MB=20
TABLE_MAX_ROWS_PER_CHUNK=10
QUERY_MAX_LENGTH=2000

# ── OCR（阶段 3 才用）──
# off 关闭 / auto 按需 / force 强制；OCR_OFFLINE=true 时只用本地模型、不出网。
OCR_MODE=auto
OCR_OFFLINE=false
# 离线模型目录与运行时动态库路径；留空则用打包默认值。
OCR_MODEL_DIRECTORY=
PDFIUM_LIB_PATH=
ORT_DYLIB_PATH=
