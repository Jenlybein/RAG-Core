# RAG 中台（rag-center）环境变量模板
# 用法：复制为 .env，然后只改 3 行：MODEL_BASE_URL、MODEL_API_KEY、LLM_API_KEY。
# .env 里有明文 Key，已在 .gitignore 里；本文件是可提交的占位版。

# ── 基础 ──
APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/rag_db
VECTOR_STORE=pgvector
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5

# ── 占位 Key 与 MCP 入口（第 1 步）──
# 数据面 HTTP 与 MCP 两扇门共用这个固定 token；第 5 步换成 api_keys 表真校验。
# ENABLE_MCP=false 只给离线测试/CI 用，生产保持 true。
DEV_API_KEY=dev-key
DEV_TENANT_ID=tenant_demo
ENABLE_MCP=true

# ── 结构化日志（第 2 步）──
# LOG_LEVEL 可用 DEBUG / INFO / WARNING / ERROR；LOG_DIR 不存在时自动创建。
LOG_LEVEL=INFO
LOG_DIR=logs

# ── Embedding（必改：Base URL 从百炼控制台 API-KEY 页面复制，含业务空间 ID）──
MODEL_BASE_URL=https://ws-xxxxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=你的百炼key
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1536
# 单批上限按模型：text-embedding-v3/v4=10、v1/v2=25、qwen3.7=20；默认 10 最保守。
EMBEDDING_BATCH_SIZE=10

# ── 大模型（必改：LLM_API_KEY；账号里没有 deepseek-v4-pro 就改成 deepseek-chat）──
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=你的deepseek key
LLM_MODEL=deepseek-chat
LLM_STRONG_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=60

# ── 重排（阶段 8 才用）──
RERANK_ENABLED=false
RERANK_BASE_URL=https://<空间ID>.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TOP_N=5
RERANK_MAX_CANDIDATES=20
RERANK_CHUNK_MAX_CHARS=1024
RERANK_TIMEOUT_SECONDS=15

# ── Elasticsearch（阶段 4 才用）──
KEYWORD_SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_chunks
RETRIEVAL_MODE=hybrid
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_TOP_N=20

# ── 鉴权（阶段 5 才用）──
AUTH_ENABLED=false

# ── 查询优化 ──
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_MS=2000

# ── 异步（阶段 3 才用）──
# broker 与 result backend 分库，任务队列和结果键互不干扰。
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── 观测（阶段 7 才用）──
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── 文档入库与边界 ──
# 原始文件落盘目录；单文件上限（MB）；表格切片每片最多行数。
DOCUMENT_STORAGE_PATH=./data/uploads
DOCUMENT_MAX_SIZE_MB=20
TABLE_MAX_ROWS_PER_CHUNK=10
QUERY_MAX_LENGTH=2000

# ── OCR（阶段 3 才用）──
# off 关闭 / auto 按需 / force 强制；OCR_OFFLINE=true 时只用本地模型、不出网。
OCR_MODE=auto
OCR_OFFLINE=false
# 离线模型目录与运行时动态库路径；留空则用打包默认值。
OCR_MODEL_DIRECTORY=
PDFIUM_LIB_PATH=
ORT_DYLIB_PATH=
